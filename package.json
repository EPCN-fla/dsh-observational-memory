{
  "name": "dsh-observational-memory",
  "version": "0.4.2",
  "description": "Observational memory for DeepSeek Harness: background observers distill session work into observations and durable reflections, so long sessions survive compaction with their decisions intact.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "observational-memory",
    "context-compaction",
    "llm-memory"
  ],
  "author": "Fla1337",
  "homepage": "https://github.com/EPCN-fla/dsh-observational-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EPCN-fla/dsh-observational-memory.git"
  },
  "bugs": "https://github.com/EPCN-fla/dsh-observational-memory/issues",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node -e \"if (require('node:fs').existsSync('build.mjs')) require('node:child_process').execFileSync(process.execPath, ['build.mjs'], { stdio: 'inherit' })\"",
    "test:scripts": "node --test scripts/*.test.mjs",
    "pack:check": "node scripts/package-artifact.mjs",
    "check": "npm run typecheck && npm test && npm run test:scripts && npm run build && npm run pack:check"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.1.5 || >=0.1.7-rc.1 <0.1.7 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-compaction": ">=0.1.5-rc.2 <0.1.5 || >=0.1.7-rc.1 <0.1.7 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.1.5 || >=0.1.7-rc.1 <0.1.7 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.1.5 || >=0.1.7-rc.1 <0.1.7 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 <0.1.5 || >=0.1.7-rc.1 <0.1.7 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.1.5 || >=0.1.7-rc.1 <0.1.7 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.2 <0.1.5 || >=0.1.7-rc.1 <0.1.7 || >=0.2.0-rc.1 <0.2.0 || >=0.2.1-rc.1 <0.2.1",
    "react": "^18.2.0"
